# ─── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
PUBLIC_APP_URL=http://localhost:3000        # frontend origin (CORS + email links)

# ─── Database (Supabase Postgres or any Postgres) ──────────────────────────
# Use the *pooled* connection string for the app, direct for migrations.
DATABASE_URL=postgresql://postgres:password@localhost:5432/trading?schema=public
DIRECT_URL=postgresql://postgres:password@localhost:5432/trading?schema=public

# ─── Redis (rate-limit store, bot locks, realtime fan-out) ─────────────────
# Optional in dev; falls back to in-memory if unset.
REDIS_URL=

# ─── Auth / JWT ────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=900            # 15 minutes (seconds)
JWT_REFRESH_TTL=2592000       # 30 days (seconds)

# ─── API-key encryption (AES-256-GCM) ──────────────────────────────────────
# 32 random bytes, base64. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
API_KEY_ENC_KEY=

# ─── Supabase (Auth + Realtime); optional if using built-in JWT auth ───────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Binance ───────────────────────────────────────────────────────────────
# Per-user keys are stored encrypted in the DB. These are only used for PUBLIC
# market data (klines, funding) which needs no auth.
BINANCE_FAPI_BASE=https://fapi.binance.com
BINANCE_SPOT_BASE=https://api.binance.com     # market data host (less geo-blocked)

# ─── Platform economics (subscription model) ───────────────────────────────
# Pricing lives in code (shared/src/index.ts → BILLING): $10/mo, 150 included
# trades, $0.10/overage, 30-day trial. Only the billing-cycle cron is env-tunable.
BILLING_CRON=0 0 * * *        # monthly invoice generation (UTC)

# ─── Notifications ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
EMAIL_FROM=noreply@yourplatform.com
SMTP_URL=

# ─── Observability ─────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info
